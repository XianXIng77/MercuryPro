# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://127.0.0.1:9100"

# Browser debugging desktop for Linux Docker deployments. The Compose port is
# bound to 127.0.0.1; use an SSH tunnel instead of exposing it publicly.
BROWSER_DEBUG_DESKTOP_ENABLED="false"
NOVNC_HOST_PORT="6080"
VNC_SCREEN="1440x900x24"

# Unified FastAPI server address. Local `npm run dev` uses port 39181 for the
# API and exposes the Vite frontend at http://127.0.0.1:3000.
HOST="0.0.0.0"
PORT="3000"

# Persistent account data directory. Defaults to ./data.
DATA_DIR="./data"

# Optional Microsoft endpoint overrides.
MICROSOFT_TOKEN_URL="https://login.microsoftonline.com/consumers/oauth2/v2.0/token"
MICROSOFT_MAIL_API_BASE_URL="https://outlook.office.com/api/v2.0"

# Optional embedded Grok engine overrides.
# GROK_ENGINE_PYTHON="D:/path/to/python.exe"
# GROK_SOLVER_PYTHON="D:/path/to/python.exe"
# GROK_MAIL_HELPER_PYTHON="D:/path/to/python.exe"
GROK_ENGINE_PORT="39181"
GROK_SOLVER_PORT="39182"
GROK_MAIL_HELPER_PORT="39183"
